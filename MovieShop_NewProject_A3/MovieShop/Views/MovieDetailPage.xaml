<Page
    x:Class="MovieShop.Views.MovieDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:MovieShop.Views"
    mc:Ignorable="d">

    <Page.Resources>
        <views:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Page.Resources>

    <Grid Background="#1E1E1E">
        <Grid Padding="32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Button Grid.Row="0"
                    Content=""
                    FontFamily="Segoe MDL2 Assets"
                    FontSize="24"
                    Click="BackButton_Click"
                    Background="Transparent"
                    Foreground="White"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,16"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#1A1A1A"
                        CornerRadius="12"
                        Margin="0,0,24,0"
                        BorderBrush="#333"
                        BorderThickness="1"
                        MaxHeight="640">
                    <Image x:Name="PosterImage"
                           Stretch="Uniform"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="16"/>
                </Border>

                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center"
                            Spacing="14"
                            MaxWidth="520">

                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               FontSize="36"
                               FontWeight="Bold"
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{x:Bind ViewModel.Description, Mode=OneWay}"
                               FontSize="16"
                               Foreground="#CCCCCC"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="{x:Bind ViewModel.RatingText, Mode=OneWay}"
                               FontSize="18"
                               Foreground="#FFC107"/>

                    <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center" Margin="0,0,0,16">

                        <TextBlock Text="{x:Bind ViewModel.OriginalPriceText, Mode=OneWay}"
                                   Visibility="{x:Bind ViewModel.HasActiveSale, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                   Foreground="Gray"
                                   FontSize="20"
                                   TextDecorations="Strikethrough"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,3"/>

                        <TextBlock Text="{x:Bind ViewModel.PriceText, Mode=OneWay}"
                                   FontSize="28"
                                   Foreground="#1DB954"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>

                    </StackPanel>

                    <Button Content="{x:Bind ViewModel.BuyButtonContent, Mode=OneWay}"
                            IsEnabled="{x:Bind ViewModel.CanBuyMovie, Mode=OneWay}"
                            Opacity="{x:Bind ViewModel.BuyButtonOpacity, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ViewModel.BuyButtonTooltip, Mode=OneWay}"
                            Click="BuyMovieButton_Click"
                            HorizontalAlignment="Stretch"
                            MinHeight="48"
                            CornerRadius="8"
                            FontSize="16"
                            FontWeight="SemiBold"/>

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0"
                                Content="See reviews"
                                ToolTipService.ToolTip="{x:Bind ViewModel.StarDistributionTooltip, Mode=OneWay}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="44"
                                CornerRadius="8"
                                Click="ReviewsButton_Click"/>
                        <Button Grid.Column="1"
                                Content="See related upcoming events"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                MinHeight="44"
                                CornerRadius="8"
                                Click="EventsButton_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
